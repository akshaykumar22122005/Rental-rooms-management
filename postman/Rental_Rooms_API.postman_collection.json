{
  "info": {
    "name": "Rental Rooms Management System API",
    "description": "Full-stack Rental Rooms Management System REST API collection with automated token extraction and environment variables.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Register Tenant",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Rahul Varma\",\n  \"email\": \"rahul.seeker@example.com\",\n  \"phoneNumber\": \"+91 9988776655\",\n  \"password\": \"Password@123\",\n  \"role\": \"ROLE_TENANT\"\n}"
            },
            "url": "{{baseUrl}}/auth/register"
          }
        },
        {
          "name": "Login (Tenant)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"tenant@rentalrooms.com\",\n  \"password\": \"Tenant@12345\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "Login (Owner)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"owner@rentalrooms.com\",\n  \"password\": \"Owner@12345\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "Login (Admin)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@rentalrooms.com\",\n  \"password\": \"Admin@12345\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "Get Authenticated User",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/auth/me"
          }
        }
      ]
    },
    {
      "name": "2. Properties (Public)",
      "item": [
        {
          "name": "Search & Filter Rooms",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/properties?city=Bengaluru&minRent=5000&maxRent=20000&sortBy=lowest_rent&page=0&size=9",
              "host": ["{{baseUrl}}"],
              "path": ["properties"],
              "query": [
                { "key": "city", "value": "Bengaluru" },
                { "key": "minRent", "value": "5000" },
                { "key": "maxRent", "value": "20000" },
                { "key": "sortBy", "value": "lowest_rent" },
                { "key": "page", "value": "0" },
                { "key": "size", "value": "9" }
              ]
            }
          }
        },
        {
          "name": "Get Featured Properties",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/properties/featured"
          }
        },
        {
          "name": "Get Room Details by ID",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/properties/1"
          }
        },
        {
          "name": "Get Categories",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/categories"
          }
        },
        {
          "name": "Get Facilities",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/facilities"
          }
        }
      ]
    },
    {
      "name": "3. Landlord Operations",
      "item": [
        {
          "name": "Create Room Listing",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Sunny 1 BHK near Metro Station\",\n  \"description\": \"Charming and well lit 1 BHK flat with balcony and power backup.\",\n  \"city\": \"Mumbai\",\n  \"locality\": \"Andheri East\",\n  \"fullAddress\": \"Flat 204, Royal Palms, Andheri East, Mumbai\",\n  \"monthlyRent\": 21000.00,\n  \"securityDeposit\": 42000.00,\n  \"maintenanceCharges\": 1500.00,\n  \"electricityCharges\": \"₹8/unit as per sub-meter\",\n  \"roomType\": \"ONE_BHK\",\n  \"furnishingStatus\": \"FULLY_FURNISHED\",\n  \"availableRooms\": 1,\n  \"genderPreference\": \"ANY\",\n  \"availabilityStatus\": \"AVAILABLE\",\n  \"houseRules\": \"No loud music after 10 PM. Family friendly.\",\n  \"categoryId\": 2,\n  \"facilityIds\": [1, 2, 3, 4, 7, 9],\n  \"imageUrls\": [\"https://images.unsplash.com/photo-1522771739844-6a9f6d5f14af?auto=format&fit=crop&w=1000&q=80\"]\n}"
            },
            "url": "{{baseUrl}}/properties"
          }
        },
        {
          "name": "Get My Properties",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/owners/me/properties"
          }
        },
        {
          "name": "Get Owner Dashboard Stats",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/owners/me/dashboard"
          }
        },
        {
          "name": "Get Rental Inquiries for Owner",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/owners/me/rental-requests"
          }
        }
      ]
    },
    {
      "name": "4. Rental Requests Workflow",
      "item": [
        {
          "name": "Submit Rental Request (Tenant)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"propertyId\": 2,\n  \"proposedMoveInDate\": \"2026-10-25\",\n  \"message\": \"Hello, I am interested in renting this room for 11 months.\"\n}"
            },
            "url": "{{baseUrl}}/rental-requests"
          }
        },
        {
          "name": "Get My Rental Requests (Tenant)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/rental-requests/me"
          }
        },
        {
          "name": "Accept or Reject Request (Owner)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"ACCEPTED\",\n  \"ownerResponse\": \"Welcome! Your move-in date of Oct 25 is confirmed.\"\n}"
            },
            "url": "{{baseUrl}}/rental-requests/1/status"
          }
        },
        {
          "name": "Cancel Pending Request (Tenant)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/rental-requests/1/cancel"
          }
        }
      ]
    },
    {
      "name": "5. Wishlist (Saved Rooms)",
      "item": [
        {
          "name": "Get Saved Rooms",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/wishlist"
          }
        },
        {
          "name": "Save Room to Wishlist",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/wishlist/1"
          }
        },
        {
          "name": "Remove Room from Wishlist",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/wishlist/1"
          }
        }
      ]
    },
    {
      "name": "6. Reviews & In-App Notifications",
      "item": [
        {
          "name": "Submit Review",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"propertyId\": 2,\n  \"rating\": 5,\n  \"comment\": \"Exceptional flat! The landlord was punctual and respectful.\"\n}"
            },
            "url": "{{baseUrl}}/reviews"
          }
        },
        {
          "name": "Get Notifications",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/notifications"
          }
        },
        {
          "name": "Mark All Notifications Read",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/notifications/read-all"
          }
        }
      ]
    },
    {
      "name": "7. Super Admin Operations",
      "item": [
        {
          "name": "Admin Dashboard Statistics",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/admin/dashboard"
          }
        },
        {
          "name": "Get All Users",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/admin/users"
          }
        },
        {
          "name": "Toggle User Status (Activate/Suspend)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"SUSPENDED\",\n  \"adminNotes\": \"Violated house rules policies\"\n}"
            },
            "url": "{{baseUrl}}/admin/users/4/status"
          }
        },
        {
          "name": "Moderate Property Listing",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"APPROVED\"\n}"
            },
            "url": "{{baseUrl}}/admin/properties/1/moderation"
          }
        }
      ]
    }
  ]
}
